{
  "name": "englishwordspractice",
  "private": true,
  "version": "1.0.0",
  "description": "Aussie English Word Practice — static app plus a small Cloudflare Worker API for the shared word list.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute englishwordspractice --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute englishwordspractice --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
