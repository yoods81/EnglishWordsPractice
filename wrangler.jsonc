{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "englishwordspractice",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// Only ./public is published. Everything else in the repo (the Worker
	// source, schema.sql, README) stays private because it simply isn't part
	// of the assets directory. Requests that don't match a file fall through
	// to the Worker, which is what serves /api/*.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	// Outgoing email (verification, password reset, username reminders) goes
	// through Cloudflare Email Service. Needs a Workers Paid plan and the
	// koalastudymate.com domain onboarded for Email Sending — see README.
	"send_email": [{ "name": "EMAIL" }],
	// Addresses/URL used in outgoing mail. Incoming mail to admin@ is handled
	// by Cloudflare Email Routing (forwarded to your own inbox), not the Worker.
	"vars": {
		"MAIL_FROM": "noreply@koalastudymate.com",
		"MAIL_REPLY_TO": "admin@koalastudymate.com",
		"APP_URL": "https://koalastudymate.com"
	},
	// The Worker reads this as env.DB.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "englishwordspractice",
			"database_id": "d668fdc3-e149-4361-bc76-b2def46fb060"
		}
	]
}